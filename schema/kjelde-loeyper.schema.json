{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fagkart/kjelde-loeyper",
  "title": "loeyper.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["loeyper"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
  },
  "properties": {
    "loeyper": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "namn", "nodar"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "namn": {"type": "string", "minLength": 1},
          "skildring": {"type": ["string", "null"]},
          "maalgruppe": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "nodar": {"type": "array", "items": {"$ref": "#/$defs/slug"}}
        }
      }
    }
  }
}
